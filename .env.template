# Copy this file to .env and add your OpenRouter key.
OPENROUTER_API_KEY=#SET ME BEFORE RUNNING THE AGENT
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
WRITING_MODEL=nvidia/nemotron-3.5-lightning:free

# Optional OpenRouter attribution:
# OPENROUTER_SITE_URL=https://your-site.example
OPENROUTER_SITE_NAME=Social Campaign Agent

# Tuning:
IMAGE_BATCH_SIZE=4
MAX_RETRIES=4
SLEEP_BETWEEN_CALLS=1.5
MAX_IMAGE_EDGE=1280
# Set to 1 to re-analyze all photos instead of using the saved inventory:
FORCE_REINVENTORY=0
